# Discord 機器人配置
# 從 Discord Developer Portal 獲取這些資訊：https://discord.com/developers/applications

# 機器人 Token（必需）
DISCORD_TOKEN=your_discord_bot_token_here

# 應用程式 ID（必需）
DISCORD_APPLICATION_ID=your_application_id_here

# 公開金鑰（必需，用於 Slash Commands 和 Webhook 驗證）
DISCORD_PUBLIC_KEY=your_public_key_here

# 伺服器限制設定
# 機器人只會在指定的伺服器中運行（必需）
ALLOWED_SERVER_ID=your_server_id_here

# 機器人只會監聽指定的頻道（必需）
ALLOWED_CHANNEL_ID=your_channel_id_here

# 日誌頻道 ID（必需，用於記錄機器人活動）
LOG_IT_CHANNEL_ID=your_log_channel_id_here

# 超級管理員用戶 ID（可選，多個 ID 用逗號分隔）
# 這些用戶擁有跨伺服器的高權限
HARD_ADMIN_USER_IDS=123456789012345678,987654321098765432

# yt-dlp 進階設定（可選）
# YouTube cookies 檔案路徑
YTDLP_COOKIES_FILE=cookies.txt

# 代理伺服器 URL（可選）
# 例如：http://user:pass@host:port 或 socks5://host:port
YTDLP_PROXY=

# YouTube Android PO Token（可選）
YTDLP_YT_ANDROID_PO_TOKEN=

# YouTube iOS PO Token（可選）
YTDLP_YT_IOS_PO_TOKEN=
